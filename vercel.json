{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/tts/audio",
      "destination": "/api/tts/audio"
    },
    {
      "source": "/api/tts/voices",
      "destination": "/api/tts/voices"
    },
    {
      "source": "/api/translate",
      "destination": "/api/translate/translate"
    },
    {
      "source": "/api/stt/transcribe",
      "destination": "/api/stt/transcribe"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/me"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth/signup"
    },
    {
      "source": "/api/auth/refresh",
      "destination": "/api/auth/refresh"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
